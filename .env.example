# =============================================================================
#  AI Inference Load Management Service — Environment Variables
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the actual `.env` file to version control.
# =============================================================================

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For Docker Compose (default):
MONGODB_URL=mongodb://mongodb:27017
# For MongoDB Atlas, replace with your connection string:
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_DB_NAME=ai_inference_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Fast Model Thresholds (SRS §2.6, §4.1) ──────────────────────────────────
FAST_MODEL_MAX_CONCURRENCY=5
FAST_MODEL_LATENCY_MIN=0.1
FAST_MODEL_LATENCY_MAX=0.2
FAST_MODEL_TIMEOUT=0.5

# ─── Slow Model / Background Worker (SRS §2.1) ───────────────────────────────
SLOW_MODEL_LATENCY_MIN=3.0
SLOW_MODEL_LATENCY_MAX=4.0

# ─── Redis Queue Backpressure (SRS §2.1 Step 3) ──────────────────────────────
MAX_QUEUE_DEPTH=50

# ─── Rate Limiting — Sliding Window (SRS §2.1 Step 2) ────────────────────────
RATE_LIMIT_PER_MIN=60

# ─── Idempotency Engine (SRS §2.1 Step 1) ────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=30

# ─── Circuit Breaker (SRS §2.1 Step 6) ───────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_FAILURE_WINDOW_SEC=10
CB_RECOVERY_TIMEOUT_SEC=30

# ─── Redis Queue Key Names (internal — do not change unless you know what you do) ─
REDIS_QUEUE_KEY=inference_queue
REDIS_CONCURRENCY_KEY=fast_model_active
REDIS_CB_STATE_KEY=circuit_breaker_state
REDIS_CB_FAILURES_KEY=circuit_breaker_failures
REDIS_CB_OPEN_SINCE_KEY=circuit_breaker_open_since
REDIS_FAULT_INJECT_KEY=fault_inject_active
REDIS_IDEMPOTENCY_PREFIX=idempotency:
REDIS_RATE_LIMIT_PREFIX=rate_limit:
REDIS_CACHE_HIT_KEY=metrics:idempotency_hits
REDIS_LATENCY_KEY=metrics:latencies
REDIS_RPS_KEY=metrics:rps

